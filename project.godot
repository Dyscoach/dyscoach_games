; Engine configuration file.
config_version=5

[application]

config/name="DysCoach Jeux"
config/description="Activités d'entraînement guidé pour enfants porteurs de troubles DYS (6 à 16 ans). Modules sans état affichés dans la plateforme web."
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.972549, 0.968627, 1, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Bridge="*res://core/bridge.gd"
SessionTimer="*res://core/session_timer.gd"
AudioService="*res://core/audio_service.gd"
Telemetry="*res://core/telemetry.gd"
ThemeService="*res://core/theme_service.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_hinting=2

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=false
